# Copy this file to .env.local and fill in the real values.
# Never commit .env.local to Git.

# Required: strong random secret used to sign session HMAC tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace_with_a_strong_random_secret

# The public URL of the deployed application (used for canonical URLs and OG images).
# Example: https://addiseats.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
